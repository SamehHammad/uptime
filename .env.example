# Copy to .env (install.sh does this for you). Never commit .env.

# Optional: a domain pointing (DNS A record) to this server -> automatic HTTPS via Caddy.
# Leave empty to use http://SERVER_IP:3001 and :3005 instead.
DOMAIN=

# Uptime Kuma admin login. install.sh generates the password if empty.
# If you set it yourself, wrap it in quotes when it contains "#".
KUMA_USERNAME=admin
KUMA_PASSWORD=

# Bearer token Claude must send to the MCP server. install.sh generates it if empty.
MCP_TOKEN=

# Timezone shown in alerts and the dashboard
TZ=Africa/Cairo

# Email alerts (optional). When set, an Arabic UP/DOWN email notification is created
# in Uptime Kuma and attached to every monitor.
SMTP_HOST=
SMTP_PORT=587
# true = TLS on port 465, false = STARTTLS on port 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
# One or more recipients, comma-separated
ALERT_TO=
